# ==============================================================================
# Environment Configuration - Telegram Analytics Dashboard
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Database Connections
# Runtime PostgreSQL connection string (Supabase Transaction Pooler port 6543 or local DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metrik?schema=public"

# Direct PostgreSQL connection string (Supabase Direct Session port 5432 for Prisma migrations)
# In local development, set to the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/metrik?schema=public"

# Application Settings
PORT=3000
NODE_ENV="development"

# Timezone Configuration
# Used for metric aggregation and daily calendar boundaries (stored in UTC, converted at edges)
APP_TIMEZONE="Africa/Addis_Ababa"

# Target Public Telegram Channel
# The username of the public channel to monitor (e.g. "mogesmotor" or "@mogesmotor")
# No personal Telegram account, API ID, API Hash, or session is required.
TELEGRAM_CHANNEL_USERNAME="mogesmotor"

# Continuous Polling Interval (in minutes)
# Default: 30 minutes (minimum 5, maximum 1440)
TELEGRAM_POLL_INTERVAL_MINUTES=30

# Public Collector Synchronization Settings
# Maximum number of public preview pages to fetch per sync (default: 2, min: 1, max: 10)
SYNC_MAX_PAGES=2

# Dashboard Access Protection (Required for API access)
# Admin password required to authenticate API requests and protect dashboard access
DASHBOARD_ADMIN_PASSWORD=""

# Optional Client Read-Only Password
# If set, clients signing in with this password are tagged as role "client" in visit logs
# and cannot view the admin-only /activity visits page.
CLIENT_ACCESS_PASSWORD=""

# Session Cookie Signing Secret (Optional)
# If omitted, a key is securely derived from DASHBOARD_ADMIN_PASSWORD using HMAC-SHA256.
SESSION_SECRET=""

# YouTube Data API v3 Integration (Optional)
# Public channel & video metrics via Google Cloud YouTube Data API v3 (Option A)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_HANDLE="MogesMotors"
YOUTUBE_SYNC_MAX_PAGES=2

# Facebook Graph API Integration (Optional)
# Page posts, reels, and insights via Meta Graph API
FACEBOOK_PAGE_ID=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_SYNC_LIMIT=50
