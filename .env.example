# ==============================================================================
# Environment Configuration - Telegram Analytics Dashboard
# Copy this file to .env or .env.local for local development.
# ==============================================================================

# Database
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metrik?schema=public"

# Application Settings
PORT=3000
NODE_ENV="development"

# Timezone Configuration
# Used for metric aggregation and daily bucket boundaries (stored in UTC, converted at edges)
APP_TIMEZONE="UTC"

# Target Public Telegram Channel
# The username of the public channel to monitor (e.g. "mogesmotor" or "@mogesmotor")
# No personal Telegram account, API ID, API Hash, or session is required.
TELEGRAM_CHANNEL_USERNAME="mogesmotor"

# Public Collector Synchronization Settings
# Maximum number of public preview pages to fetch per sync (default: 2, min: 1, max: 10)
SYNC_MAX_PAGES=2

# Dashboard Access Protection (Required for API access)
# Admin password required to authenticate API requests and protect dashboard access
DASHBOARD_ADMIN_PASSWORD=""
