# ==============================================================================
# Environment Configuration - Telegram Analytics Dashboard
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Database
# PostgreSQL connection string for Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/metrik?schema=public"

# Application Settings
PORT=3000
NODE_ENV="development"

# Timezone Configuration
# Used for metric aggregation and daily bucket boundaries (stored in UTC, converted at edges)
APP_TIMEZONE="UTC"

# Telegram API Credentials
# Obtain API ID and API Hash from https://my.telegram.org
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Target Telegram Channel
# The username or channel ID of the channel you administer
TELEGRAM_CHANNEL_ID=""

# Dashboard Access Protection (Optional for local development, required for public deployments)
# Admin password to protect dashboard API routes and sync controls
DASHBOARD_ADMIN_PASSWORD=""
